  {
   "id": "profile_path_windows",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![A-Za-z0-9])(?:[A-Za-z]:|/mnt/[A-Za-z])[\\\\/]+Users[\\\\/]+(?!(?:Public|Default|Administrator|All Users)(?![A-Za-z0-9_.-]))(?![<%${\\[(*.])[^\\\\/ \"'<>|:*?]+",
   "flags": "i",
   "description": "A Windows user-profile path: a drive letter (or a WSL mount), Users, then a folder name. The angle-bracket placeholder, an environment-variable placeholder and the shared Public, Default, Administrator and All Users folders are allowed. Doubled backslashes (JSON text) and forward slashes are covered.",
   "positive_samples": [
    [
     "C:",
     "\\Users",
     "\\jsample",
     "\\Desktop"
    ],
    [
     "c:/users",
     "/jsample/",
     "x"
    ],
    [
     "C:\\\\",
     "Users\\\\",
     "jsample\\\\",
     "AppData"
    ]
   ],
   "negative_samples": [
    [
     "C:\\Users",
     "\\<user>",
     "\\AppData"
    ],
    [
     "%USER",
     "PROFILE%",
     "\\Desktop"
    ],
    [
     "C:\\Users",
     "\\Public\\",
     "Documents"
    ],
    [
     "C:\\Program",
     " Files\\App"
    ],
    [
     "C:\\Users",
     "\\"
    ]
   ]
  },
  {
   "id": "profile_path_linux",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![A-Za-z0-9_.~-])/(?:home|Users)/(?!user(?![A-Za-z0-9_.-]))(?![<%${\\[(*.])[A-Za-z0-9_][A-Za-z0-9_.-]*",
   "flags": "",
   "description": "A /home or /Users path under any folder name other than the generic placeholder 'user' (and other than bracketed or variable placeholders). A path inside a longer URL is not matched.",
   "positive_samples": [
    [
     "/home",
     "/jsample/",
     "projects"
    ],
    [
     "/Users",
     "/jsample/",
     "Desktop"
    ]
   ],
   "negative_samples": [
