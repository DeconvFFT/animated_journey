     "1.2.3",
     ".4.5"
    ]
   ]
  },
  {
   "id": "ipv6",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![0-9A-Za-z_:])(?!2001:0{0,3}[dD][bB]8:)(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){2,6}|(?:[0-9A-Fa-f]{1,4}:){2}(?::[0-9A-Fa-f]{1,4}){1,5}|(?:[0-9A-Fa-f]{1,4}:){3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){6}:[0-9A-Fa-f]{1,4}|:(?::[0-9A-Fa-f]{1,4}){3,7})(?![0-9A-Za-z_]|:[0-9A-Fa-f:])",
   "flags": "",
   "description": "An IPv6 address: eight groups, or a compressed form with three to seven explicit groups. The 2001:db8::/32 documentation prefix is allowed. Short forms such as a loopback or a link-local suffix carry no identity and are not matched.",
   "positive_samples": [
    [
     "2a02:",
     "8071:1b0:6d00:",
     "a1c3:44ff:fe19:7e52"
    ],
    [
     "2a00:1450:",
     "4009:81c::",
     "200e"
    ],
    [
     "2a02:",
     "8071:1b0",
     "::a1c3:44ff"
    ]
   ],
   "negative_samples": [
    [
     "2001:",
     "db8::1"
    ],
    [
     "2001:",
     "db8:85a3:",
     ":8a2e:370",
     ":7334"
    ],
    [
     "2001:0",
     "db8:0:0:0:0:0:1"
    ],
    [
     ":",
     ":1"
    ],
    [
     "fe80",
     "::1"
    ],
    [
     "12:30:",
     "45"
    ],
    [
     "Add",
     "::add"
    ]
   ]
  },
  {
   "id": "mac",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![0-9A-Za-z:-])(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}(?![0-9A-Za-z]|:[0-9A-Fa-f])|(?<![0-9A-Za-z:-])(?:[0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}(?![0-9A-Za-z]|-[0-9A-Fa-f])",
   "flags": "",
   "description": "A MAC address: six hex pairs joined by colons or by dashes.",
   "positive_samples": [
