     "PUBLIC KEY-----"
    ]
   ]
  },
  {
   "id": "guid_serial",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![0-9A-Fa-f])[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}(?![0-9A-Fa-f])|(?<![0-9A-Fa-f])[0-9A-Fa-f]{32,}(?![0-9A-Fa-f])|(?<![A-Za-z0-9])(?=(?:[A-Z]*[0-9]){3})(?=(?:[0-9]*[A-Z]){3})[A-Z0-9]{10,40}(?![A-Za-z0-9])",
   "flags": "",
   "description": "A GUID in 8-4-4-4-12 form; any hex run of 32 or more characters (a run of exactly 64 is exempted below); and serial-like tokens of 10 to 40 upper-case letters and digits with at least three of each.",
