   "id": "handle",
   "scope": "text",
   "action": "refuse",
   "regex": "(?<![A-Za-z0-9_.@/\\\\-])@[A-Za-z][A-Za-z0-9_]{2,29}(?![A-Za-z0-9_@-]|/)",
   "flags": "",
   "apply_to": [
    "*.md",
    "*.csv",
    "*.json",
    "*.txt"
   ],
   "description": "An at-sign social handle in prose. Applied to .md, .csv, .json and .txt files only and never to code, where an at sign before a variable name is PowerShell splatting. Package scopes (followed by a slash) and a letter-less start are not matched.",
