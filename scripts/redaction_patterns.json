 "exemptions": [
  {
   "id": "sha256_64hex",
   "category": "guid_serial",
   "regex": "(?<![0-9A-Fa-f])[0-9A-Fa-f]{64}(?![0-9A-Fa-f])",
   "flags": "",
   "description": "A hex run of exactly 64 characters not flanked by hex digits is a SHA-256 (ffmpeg binary hashes, release checksums): public build identity, not a serial. A run of 65 or more, or of 32 to 63, is still a hit."
  },
  {
   "id": "reserved_example_email_domains",
   "category": "email",
   "regex": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@(?:example\\.(?:com|org|net)|[A-Za-z0-9-]+\\.(?:example|invalid|test|localhost))(?![A-Za-z0-9-])",
   "flags": "i",
   "description": "Addresses on the domains reserved for documentation (example.com, example.org, example.net and the .example, .invalid, .test and .localhost names) identify nobody. Case-insensitive, like an e-mail address itself (review r1 of WP-03). Added in v1 beside the required samples."
  },
  {
   "id": "url_embedded_ids",
   "category": "guid_serial",
   "regex": "https?://[^ )>\\]\"'`,]+",
   "flags": "",
   "description": "An identifier inside a web address is a citation of a public page (a GUID in a support-page path, a node id, a commit URL), not a device or person identity. Only guid_serial is exempted; an address or e-mail inside a link is still a hit."
  },
  {
   "id": "known_non_serial_tokens",
   "category": "guid_serial",
   "regex": "(?<![A-Za-z0-9])(?:SHA(?:1|256|384|512)SUMS?|PRORES(?:422|4444)[A-Z]{0,5}|PMC[0-9]{6,9})(?![A-Za-z0-9])",
   "flags": "",
   "description": "Upper-case technical vocabulary that has the shape of a serial: checksum file names (SHA256SUMS), ProRes profile names, and PubMed Central article ids. Add a token here only when it is public vocabulary, with a negative sample."
  },
  {
   "id": "at_words_not_handles",
   "category": "handle",
   "regex": "(?<![A-Za-z0-9_.@/\\\\-])@(?:font|fontsource|keyframes|media|import|charset|page|supports|layer|param|returns?|example|see|todo|deprecated|override|echo|context|type|id|graph|main|tag|mentions?)(?![A-Za-z0-9_@-]|/)",
   "flags": "",
   "description": "At-rules, documentation tags and package-scope words that are not social handles."
  }
 ],
 "field_exemptions": [
  {
   "category": "ipv4",
   "fields": [
    "gpus[].driver_version",
    "os.version",
    "os.build",
    "powershell.version",
    "tools.*.version",
    "craft_apps.found[].version",
    "craft_apps.found[].pinned_version",
    "vulkan.devices[].driver_version"
   ],
   "description": "Version fields of a PC report can be four dot-separated numbers below 256; they are not addresses (F-15)."
  }
 ],
 "name_checks": {
  "sources": [
   "user",
   "computer",
   "domain"
  ],
  "sources_note": "read from the environment at run time and never stored",
  "match": "whole word, case-insensitive, anywhere in the report",
  "min_name_len": 3,
  "min_name_len_note": "a shorter name is skipped with a NOTE because it would match ordinary words",
  "fragment_len": 4,
  "fragment_min_name_len": 5,
  "fragment_note": "any 4-character fragment of a name of 5 or more characters",
  "hardware_name_fields": [
   "cpu.name",
   "gpus[].name",
   "gpus[].vendor",
   "os.caption"
  ],
  "hardware_field_action": "report",
  "rule": "a name hit anywhere except a hardware-name field refuses the write; a name hit inside a hardware-name field is reported (a NOTE with category, field and masked hit, also recorded in redaction.name_hits_in_hardware_fields[]), not refused. The pattern categories are never relaxed by this rule."
 },
 "mask": {
  "keep": 2,
  "fill": "*",
  "cap": 8
 },
 "placeholders": [
  "C:\\Users\\<user>",
  "%USERPROFILE%",
  "/home/user",
  "/home/user/build-scratch",
  "<scratch>"
 ],
 "placeholder_aliases": {
  "/home/user/build-scratch": "<scratch>"
 },
 "path_denylist": [
  "**/pc_report*.json",
  "**/colour_patch_pc*.json",
  "**/maker-pc*.json"
 ],
 "path_denylist_exempt_dirs": [
  "tests/win/fixtures/"
 ],
 "path_denylist_note": "refused by public_lint.py anywhere in the tree except under the exempt dirs, where every file is synthetic. The raw PC reports are a hardware fingerprint of one machine and never enter the repository.",
 "local_deny": "scripts/public_lint.deny.local.txt",
 "local_deny_note": "optional, git-ignored; one word per line (the maker's real names and PC name); loaded on the maker's machine only; never printed.",
