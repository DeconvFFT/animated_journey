     "/<user>/x"
    ]
   ]
  },
  {
   "id": "token_shape",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{36,}(?![A-Za-z0-9_])|(?<![A-Za-z0-9_])github_pat_[A-Za-z0-9_]{40,}(?![A-Za-z0-9])|(?<![A-Za-z0-9_])sk-(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{20,}(?![A-Za-z0-9_-])|(?<![A-Za-z0-9])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Za-z0-9])|(?<![A-Za-z0-9_])xox[abprs]-[A-Za-z0-9-]{20,}(?![A-Za-z0-9-])|(?<![A-Za-z0-9_])AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])|-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----",
   "flags": "",
   "description": "Secret-token shapes with a length rule each: GitHub classic (prefix plus 36 or more) and fine-grained (prefix plus 40 or more), sk-style API keys (20 or more characters including a digit), AWS access-key ids (prefix plus 16), Slack and Google API-key forms, and private-key block headers. A bare prefix in prose is not a hit.",
   "positive_samples": [
    [
     "gh",
     "p_",
     "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"
    ],
    [
