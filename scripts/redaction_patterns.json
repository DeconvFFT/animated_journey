{
 "schema": "lj-redaction-patterns/1",
 "version": 1,
 "owner": "WP-03",
 "status": "frozen",
 "dialect": "common subset of Python re and .NET regex: [0-9] not \\d, \\b and backslash-punctuation escapes only, non-capturing groups, character classes, {m,n}, lookahead, fixed-width lookbehind; no named groups, no possessive quantifiers, no atomic groups, no inline flags (flags is '' or 'i'), no \\w \\s \\d.",
 "how_to_read": "Samples are arrays of string fragments joined at load time, so this file never contains the strings it forbids. A consumer joins the fragments, applies placeholders, exemptions and field_exemptions, and reports category ids. Never print a flagged value in full: mask keeps the first two characters.",
 "categories": [
  {
   "id": "email",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}",
   "flags": "",
   "description": "An e-mail address (local part, at sign, dotted domain). The reserved example domains are exempted below.",
   "positive_samples": [
    [
     "ja",
     "ne.doe+t",
     "@",
     "mailbox-",
     "test",
     ".io"
    ],
    [
     "r.k.sh",
     "arma83",
     "@",
     "notarealhost",
     ".in"
    ]
   ],
   "negative_samples": [
    [
     "ffmpeg version 9.0.2-essentials_build-www",
     ".gyan.dev"
    ],
    [
     "someone",
