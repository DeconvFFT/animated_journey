     "Example",
     ".ORG"
    ],
    [
     "write to the",
     " maintainer ",
     "at",
     " the project page"
    ]
   ]
  },
  {
   "id": "ipv4",
   "scope": "both",
   "action": "refuse",
   "regex": "(?<![0-9.])(?!(?:192\\.0\\.2|198\\.51\\.100|203\\.0\\.113)\\.[0-9]{1,3}(?![0-9]|\\.[0-9]))(?!127\\.0\\.0\\.1(?![0-9]|\\.[0-9]))(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?![0-9]|\\.[0-9])",
   "flags": "",
   "description": "A dotted IPv4 address: four octets 0-255 without leading zeros, not flanked by digits or dots. The documentation ranges 192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24 and 127.0.0.1 are allowed. Version strings that look like addresses are handled by field_exemptions (report fields) and by the no-leading-zero and not-flanked rules.",
   "positive_samples": [
    [
     "84.1",
     "12.9.200"
    ],
    [
     "10.20",
     ".30.40"
    ],
    [
     "192.0",
     ".3.1"
    ],
    [
     "198.51",
     ".101.7"
    ],
    [
     "203.0",
     ".112.9"
    ],
    [
     "127.0",
     ".0.2"
    ]
   ],
   "negative_samples": [
    [
     "192.0",
     ".2.1"
    ],
    [
     "198.51",
     ".100.7"
    ],
    [
     "203.0",
     ".113.9"
    ],
    [
     "127.0",
     ".0.1"
    ],
    [
     "10.0.2",
     "2631.4317"
    ],
    [
     "31.0.15",
     ".5222"
    ],
    [
     "23.40.27",
     ".06"
    ],
    [
     "6.1",
     ".1"
