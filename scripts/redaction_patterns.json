     "_pat_",
     "11AA",
     "AAAAA0",
     "abcdefghijklmnopqrstuvwxyz0123456789",
     "ABCDEFGHIJ"
    ],
    [
     "sk",
     "-",
     "proj-a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6"
    ],
    [
     "AK",
     "IA",
     "ABCDEFGH",
     "12345678"
    ],
    [
     "-----BEGIN ",
     "RSA PRIVATE",
     " KEY-----"
    ]
   ],
   "negative_samples": [
