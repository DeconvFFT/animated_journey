#!/usr/bin/env python3
"""A STAND-IN for filmcraft-cli, used only to test the SP1 harness. It is not FilmCraft and says nothing about FilmCraft.
It implements the command surface the T1/T2 drivers use (the shape of research/cinematic-quality-fixtures/filmcraft_push.py and docs/agents.md) with the
model the T2 driver checks: scale 100 = native pixels, position (960,540) = centre of the frame, keyframes linear. Planted defects are switched on by
the words in the file fake_bug.txt next to this script: leak, offset, dropframe, offline, dissolve, crash, stepped, encodedblend. No network, no GPU, Pillow, ffmpeg;
numpy for the dissolve.
THE DISSOLVE (amended Tue 20 Oct 2026 with the T2.mid_dissolve mark): like FilmCraft 0.9.0 and 0.8.0, which the first real run measured, the stand-in blends in LINEAR LIGHT
(the sRGB transfer function), so its half-way frame is the linear-light mix of the neighbours. `encodedblend` brings back the old behaviour (Pillow's Image.blend of the encoded
values, which is also what ffmpeg xfade and the Chromium route show); it must make T2.mid_dissolve fail. `stepped` holds each blend level for two frames (the stepping the single-frame
probe of 20 Oct showed in FilmCraft); it must make T2.dissolve_steps fail. `dissolve` scales the blend weight by 0.8 (a wrong mid-point).
EXPORT: a flat-colour clip, except that an export of at most 120 frames whose window touches a transition renders the real frames of the project (what T2.dissolve_steps reads)."""
import json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
BUGS = set(open(os.path.join(HERE, "fake_bug.txt")).read().split()) if os.path.exists(os.path.join(HERE, "fake_bug.txt")) else set()
TICKS = 254016000000
VERSION = os.environ.get("FAKE_VERSION") or (open(os.path.join(HERE, "fake_version.txt")).read().strip() if os.path.exists(os.path.join(HERE, "fake_version.txt")) else "0.9.0")
IDS = ["file.newProject", "file.import", "file.newSequence", "timeline.place", "effects.setParam", "effects.setInterpolation", "sequence.applyVideoTransition", "file.exportInterchange"]


def die(msg, code=1):
    sys.stderr.write("filmcraft-cli: %s\n" % msg)
    sys.exit(code)


def touch_memory(mb):
    b = bytearray(int(mb * 1048576))
    for i in range(0, len(b), 4096):
        b[i] = 1
    return b


def load(path):
    if path and os.path.exists(path):
        return json.load(open(path))
    return {"next": 1, "items": {}, "seq": None, "clips": []}


def save(st, path):
    json.dump(st, open(path, "w"))


def alloc(st):
    i = st["next"]
    st["next"] += 1
    return i


def scale_at(clip, t):
    keys = sorted(clip.get("keys", {}).get("scale", []))
    if not keys:
        return None
    if t <= keys[0][0]:
        return keys[0][1]
    if t >= keys[-1][0]:
        return keys[-1][1]
    for (t0, v0), (t1, v1) in zip(keys, keys[1:]):
        if t0 <= t <= t1:
            return v0 + (v1 - v0) * (t - t0) / float(t1 - t0)


_LUT = {}


def blend(im1, im2, a):
    """Blend two PIL RGB images with weight a for im2: in linear light (the default), or on the encoded values under the planted defect `encodedblend`."""
    from PIL import Image
    if "encodedblend" in BUGS:
        return Image.blend(im1, im2, a)
    import numpy as np
    if not _LUT:
        v = np.arange(256) / 255.0
        _LUT["lin"] = np.where(v <= 0.04045, v / 12.92, ((v + 0.055) / 1.055) ** 2.4).astype(np.float32)
        l = np.arange(65536) / 65535.0
        enc = np.where(l <= 0.0031308, 12.92 * l, 1.055 * l ** (1 / 2.4) - 0.055)
        _LUT["inv"] = np.clip(np.rint(enc * 255.0), 0, 255).astype(np.uint8)
    mixed = (1.0 - a) * _LUT["lin"][np.asarray(im1)] + a * _LUT["lin"][np.asarray(im2)]
    return Image.fromarray(_LUT["inv"][np.clip(np.rint(mixed * 65535.0), 0, 65535).astype(np.uint16)], "RGB")


def in_transition(st, t0, t1):
    """Does any transition's blend window overlap the span [t0, t1) (ticks)?"""
    fps = st["seq"]["fps"]
    for tr in st.get("transitions", []):
        clip = next((c for c in st["clips"] if c["id"] == tr["clip"]), None)
        if clip:
            half = tr["frames"] * (TICKS // fps) // 2
            if clip["start"] - half < t1 and t0 < clip["start"] + half:
                return True
    return False


def render_frame(st, sec):
    from PIL import Image
    seq = st["seq"]
    W, H, fps = seq["w"], seq["h"], seq["fps"]
    t = int(round(sec * TICKS))

    def of(clip):
        im = Image.open(st["items"][str(clip["item"])]["path"]).convert("RGB")
        w, h = im.size
        s = scale_at(clip, t - clip["start"])
        s = (max(W / float(w), H / float(h)) * 100.0) if s is None else s
        k = s / 100.0
        dx = 3.0 if "offset" in BUGS else 0.0
        return im.transform((W, H), Image.AFFINE, (1 / k, 0, w / 2.0 - (W / 2.0 - dx) / k, 0, 1 / k, h / 2.0 - (H / 2.0) / k), resample=Image.BILINEAR)

    cur = [c for c in st["clips"] if c["start"] <= t < c["start"] + c["dur"]]
    if not cur:
        return Image.new("RGB", (W, H), (0, 0, 0))
    base = of(cur[-1])
    for tr in st.get("transitions", []):
        clip = next((c for c in st["clips"] if c["id"] == tr["clip"]), None)
        if not clip:
            continue
        half = tr["frames"] * (TICKS // fps) // 2
        if clip["start"] - half <= t < clip["start"] + half:
            prev = [c for c in st["clips"] if c["start"] + c["dur"] == clip["start"]]
            if prev:
                a = (t - (clip["start"] - half)) / float(2 * half)
                if "stepped" in BUGS:  # each blend level held for two frames
                    a = (int(round(a * tr["frames"])) // 2 * 2) / float(tr["frames"])
                a = a * 0.8 if "dissolve" in BUGS else a
                return blend(of(prev[0]), of(clip), a)
    return base


def main(argv):
    if argv and argv[0] == "--version":
        print("filmcraft-cli %s" % VERSION)
        return 0
    proj = save_to = None
    do_save = False
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--project":
            proj = argv[i + 1]; i += 2
        elif a == "--save-as":
            save_to = argv[i + 1]; i += 2
        elif a == "--save":
            do_save = True; i += 1
        elif a in ("--demo", "--compact", "--keep-going"):
            i += 1
        else:
            rest.append(a); i += 1
    if not rest:
        die("usage: filmcraft-cli [OPTIONS] <SUBCOMMAND>", 2)
    sub, args = rest[0], rest[1:]
    st = load(proj)
    n_items = len(st["items"])
    if "leak" in BUGS:
        touch_memory(30 + 120 * n_items)
    else:
        touch_memory(30 + 1.0 * n_items)
    if sub == "commands":
        for k in range(40):
            print("cmd.%02d   a stand-in command" % k)
        for c in IDS:
            print(c)
        return 0
    if sub == "describe":
        if args and args[0] in IDS:
            print(json.dumps({"id": args[0], "params": {"doc": "stand-in"}}))
            return 0
        die("unknown command", 1)
    if sub == "inspect":
        what = args[0] if args else "sequence"
        if what == "project":
            print(json.dumps({"items": [{"id": int(k), "name": os.path.basename(v["path"]), "path": v["path"]} for k, v in st["items"].items()]}))
        else:
            seq = st["seq"] or {"w": 1920, "h": 1080, "fps": 24}
            print(json.dumps({"sequence": dict(seq, durationFrames=0), "clips": [{"id": c["id"], "item": c["item"], "track": "V1", "start": c["start"], "duration": c["dur"]} for c in st["clips"]]}))
        return 0
    cmds = []
    if sub == "exec":
        cid = args[0]
        params = {}
        for a in args[1:]:
            if a.startswith("{"):
                params = json.loads(a)
            elif "=" in a:
                k, v = a.split("=", 1)
                params[k] = v
        cmds = [(cid, params)]
    elif sub == "run":
        for ln in open(args[0]):
            ln = ln.strip()
            if ln and not ln.startswith("#"):
                d = json.loads(ln)
                cmds.append((d["id"], d.get("params", {})))
    if cmds:
        out = []
        for cid, p in cmds:
            res = {}
            if cid == "file.newProject":
                st = {"next": 1, "items": {}, "seq": None, "clips": []}
            elif cid == "file.import":
                if "crash" in BUGS and len(p["paths"]) >= 12:
                    os._exit(139)
                ids = []
                for path in p["paths"]:
                    i2 = alloc(st); st["items"][str(i2)] = {"path": path}; ids.append(i2)
                res = {"items": ids}
            elif cid == "file.newSequence":
                st["seq"] = {"w": p["width"], "h": p["height"], "fps": p["fps"]}
                st["next"] = max(st["next"], 8)
            elif cid == "timeline.place":
                items = p.get("items") or [p["item"]]
                made = []
                for k, it in enumerate(items):
                    c = {"id": alloc(st), "item": it, "start": int(round(p.get("seconds", k) * TICKS)), "dur": int(p.get("duration", 5 * TICKS)), "keys": {}}
                    st["clips"].append(c); made.append(c["id"])
                res = {"clips": made}
            elif cid == "effects.setParam":
                c = next(c for c in st["clips"] if c["id"] == p["clip"])
                c.setdefault("keys", {}).setdefault(p["param"], []).append([p.get("time", 0), p["value"]])
            elif cid == "effects.setInterpolation":
                pass
            elif cid == "sequence.applyVideoTransition":
                st.setdefault("transitions", []).append({"clip": p["clip"], "frames": p["frames"]})
            else:
                die("unknown command id %s" % cid, 1)
            out.append({"id": cid, "ok": True, "result": res})
        if len(out) == 1 and sub == "exec":
            print(json.dumps(out[0]["result"]))
        else:
            for k, o in enumerate(out):
                print(json.dumps({"line": k + 1, "id": o["id"], "ok": True, "result": o["result"]}))
        if save_to:
            save(st, save_to)
        elif do_save and proj:
            save(st, proj)
        return 0
    if sub == "render":
        sec = float(args[args.index("--seconds") + 1]); out = args[args.index("--out") + 1]
        render_frame(st, sec).save(out)
        print(json.dumps({"path": out}))
        return 0
    if sub == "export":
        out = args[0]
        preset = args[args.index("--preset") + 1] if "--preset" in args else ""
        seq = st["seq"]
        total = max((c["start"] + c["dur"] for c in st["clips"]), default=0)
        a0 = float(args[args.index("--start") + 1]) if "--start" in args else 0.0
        a1 = float(args[args.index("--end") + 1]) if "--end" in args else total / float(TICKS)
        frames = int(round((a1 - a0) * seq["fps"])) - (1 if "dropframe" in BUGS else 0)
        offline = [{"item": int(k), "path": v["path"], "status": "missing"} for k, v in st["items"].items() if not os.path.exists(v["path"])]
        if "offline" in BUGS:
            offline = [{"item": 1, "path": "x", "status": "missing"}]
        if "ProRes" in preset:
            codec = ["-c:v", "prores_ks", "-profile:v", "3", "-pix_fmt", "yuv422p10le", "-vendor", "apl0"]
        else:
            codec = ["-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p"]
        if 0 < frames <= 120 and in_transition(st, int(round(a0 * TICKS)), int(round(a1 * TICKS))):
            # the real frames of the project: what a dissolve-stepping check reads back from the export
            pr = subprocess.Popen(["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", "%dx%d" % (seq["w"], seq["h"]), "-r", str(seq["fps"]), "-i", "-"] + codec + [out],
                                  stdin=subprocess.PIPE, stderr=subprocess.PIPE)
            for i in range(frames):
                pr.stdin.write(render_frame(st, a0 + i / float(seq["fps"])).tobytes())
            pr.stdin.close()
            err = pr.stderr.read().decode("utf-8", "replace")
            if pr.wait():
                die("encode failed: " + err[-200:], 1)
        else:
            r = subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "color=c=0x305070:s=320x180:r=%d" % seq["fps"], "-frames:v", str(frames)] + codec + [out],
                               capture_output=True, text=True)
            if r.returncode:
                die("encode failed: " + r.stderr[-200:], 1)
        print(json.dumps({"path": out, "frames": frames, "offlineMedia": offline}))
        return 1 if offline else 0
    die("unknown subcommand %s" % sub, 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
